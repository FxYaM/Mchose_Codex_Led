{
    "hooks":  {
                  "UserPromptSubmit":  [
                                           {
                                               "hooks":  [
                                                             {
                                                                 "type":  "command",
                                                                 "command":  "\"\u003cABSOLUTE_PATH_TO_NODE_EXE\u003e\" \"\u003cABSOLUTE_INSTALL_DIRECTORY\u003e\\hook-handler.cjs\"",
                                                                 "timeout":  3
                                                             }
                                                         ]
                                           }
                                       ],
                  "Stop":  [
                               {
                                   "hooks":  [
                                                 {
                                                     "type":  "command",
                                                     "command":  "\"\u003cABSOLUTE_PATH_TO_NODE_EXE\u003e\" \"\u003cABSOLUTE_INSTALL_DIRECTORY\u003e\\hook-handler.cjs\"",
                                                     "timeout":  3
                                                 }
                                             ]
                               }
                           ],
                  "Interrupt":  [
                                    {
                                        "hooks":  [
                                                      {
                                                          "type":  "command",
                                                          "command":  "\"\u003cABSOLUTE_PATH_TO_NODE_EXE\u003e\" \"\u003cABSOLUTE_INSTALL_DIRECTORY\u003e\\hook-handler.cjs\"",
                                                          "timeout":  3
                                                      }
                                                  ]
                                    }
                                ],
                  "PermissionRequest":  [
                                            {
                                                "hooks":  [
                                                              {
                                                                  "type":  "command",
                                                                  "command":  "\"\u003cABSOLUTE_PATH_TO_NODE_EXE\u003e\" \"\u003cABSOLUTE_INSTALL_DIRECTORY\u003e\\hook-handler.cjs\"",
                                                                  "timeout":  3
                                                              }
                                                          ]
                                            }
                                        ],
                  "PreToolUse":  [
                                     {
                                         "matcher":  "^(request_user_input|request_permissions)$",
                                         "hooks":  [
                                                       {
                                                           "type":  "command",
                                                           "command":  "\"\u003cABSOLUTE_PATH_TO_NODE_EXE\u003e\" \"\u003cABSOLUTE_INSTALL_DIRECTORY\u003e\\hook-handler.cjs\"",
                                                           "timeout":  3
                                                       }
                                                   ]
                                     }
                                 ],
                  "PostToolUse":  [
                                      {
                                          "matcher":  ".*",
                                          "hooks":  [
                                                        {
                                                            "type":  "command",
                                                            "command":  "\"\u003cABSOLUTE_PATH_TO_NODE_EXE\u003e\" \"\u003cABSOLUTE_INSTALL_DIRECTORY\u003e\\hook-handler.cjs\"",
                                                            "timeout":  3
                                                        }
                                                    ]
                                      }
                                  ],
                  "SessionEnd":  [
                                     {
                                         "hooks":  [
                                                       {
                                                           "type":  "command",
                                                           "command":  "\"\u003cABSOLUTE_PATH_TO_NODE_EXE\u003e\" \"\u003cABSOLUTE_INSTALL_DIRECTORY\u003e\\hook-handler.cjs\"",
                                                           "timeout":  3
                                                       }
                                                   ]
                                     }
                                 ]
              }
}
